# =============================================================================
# MOCK-режим (по умолчанию, если .env отсутствует)
# Скопируйте в .env для демо без backend:
# =============================================================================
# VITE_API_URL=
# VITE_USE_MOCK_ANALYSIS=true

# =============================================================================
# LIVE backend — скопируйте файл в .env (обязательно!) и перезапустите npm run dev
# cp .env.example .env
# =============================================================================
# НЕ указывайте http://localhost:8080 — в dev это вызывает CORS.
# Пустой VITE_API_URL → запросы идут на localhost:5173/auth/... и проксируются на :8080
VITE_API_URL=
VITE_USE_MOCK_ANALYSIS=false

# Backend должен быть запущен: docker compose up --build
